<Window x:Class="RomForge.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="압축파일 비밀번호"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1E1E1E"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtMessage" Grid.Row="0"
                   Text="이 압축파일은 비밀번호로 보호되어 있습니다."
                   Foreground="#DCDCDC" FontSize="13" TextWrapping="Wrap"/>

        <TextBlock x:Name="txtFileName" Grid.Row="1" Margin="0,4,0,12"
                   Foreground="#888888" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>

        <TextBox x:Name="pwBox" Grid.Row="2"
                 Height="32" Padding="8,2" FontSize="13"
                 Background="#2D2D30" Foreground="White" BorderBrush="#444444" BorderThickness="1"
                 VerticalContentAlignment="Center"
                 KeyDown="PwBox_KeyDown"/>

        <TextBlock x:Name="txtError" Grid.Row="3" Margin="0,8,0,0"
                   Text="비밀번호가 올바르지 않습니다." Foreground="#FF6B6B" FontSize="12"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="취소" Width="80" FontSize="12" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button Content="확인" Width="80" FontSize="12" Style="{StaticResource PrimaryButton}" Click="BtnOk_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>